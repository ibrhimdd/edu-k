    <!-- Interactive Playground Scripts -->
    <script>
        const codeSnippets = {
            js: `// لغة JavaScript\nfunction welcomeUser(name) {\n    return "أهلاً بك " + name + " في عالم البرمجة! 🚀";\n}\n\nconsole.log(welcomeUser("يا مبرمج المستقبل"));`,
            python: `# لغة Python\ndef welcome_user(name):\n    return f"أهلاً بك {name} في عالم البرمجة! 🚀"\n\nprint(welcome_user("يا مبرمج المستقبل"))`
        };

        let currentLang = 'js';
        const codeInput = document.getElementById('code-input');
        const codeOutput = document.getElementById('code-output');

        // Set initial code
        codeInput.value = codeSnippets.js;

        function selectLanguage(lang) {
            currentLang = lang;
            const btnJs = document.getElementById('btn-js');
            const btnPython = document.getElementById('btn-python');

            if (lang === 'js') {
                btnJs.className = "px-4 py-1.5 rounded-lg text-sm font-bold bg-brand-teal text-white";
                btnPython.className = "px-4 py-1.5 rounded-lg text-sm font-bold text-gray-300 hover:bg-gray-700";
            } else {
                btnPython.className = "px-4 py-1.5 rounded-lg text-sm font-bold bg-brand-teal text-white";
                btnJs.className = "px-4 py-1.5 rounded-lg text-sm font-bold text-gray-300 hover:bg-gray-700";
            }

            codeInput.value = codeSnippets[lang];
            codeOutput.innerText = `> تم تغيير اللغة إلى ${lang.toUpperCase()}. اضغط "تشغيل الكود" للتجربة.`;
        }

        function runCode() {
            codeOutput.innerText = "> جاري التشغيل...\n";
            setTimeout(() => {
                if (currentLang === 'js') {
                    codeOutput.innerText = "> Output:\nأهلاً بك يا مبرمج المستقبل في عالم البرمجة! 🚀\n\n[تم تنفيذ الكود بنجاح ✨]";
                } else {
                    codeOutput.innerText = "> Output (Python Simulation):\nأهلاً بك يا مبرمج المستقبل في عالم البرمجة! 🚀\n\n[Process finished with exit code 0]";
                }
            }, 300);
        }

        // Mobile menu toggle
        const menuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');

        menuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });
    </script>
