rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasUserProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentRole() {
      return hasUserProfile()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isPlatformAdmin() {
      return currentRole() == 'platform_admin';
    }

    function isResearcher() {
      return currentRole() == 'researcher';
    }

    function isAcademicSupervisor() {
      return currentRole() == 'academic_supervisor';
    }

    function isStaffReader() {
      return isPlatformAdmin() || isResearcher() || isAcademicSupervisor();
    }

    function canEditAcademicContent() {
      return isPlatformAdmin() || isResearcher();
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isTeamMember(teamId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(teamId))
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(teamId)).data.memberIds;
    }

    match /users/{userId} {
      // Staff can inspect profiles; students can inspect only their own profile.
      allow read: if isStaffReader() || isOwner(userId);

      // Public registration is restricted to student profiles. Staff profiles
      // must be provisioned through a trusted administrative process.
      allow create: if isOwner(userId)
        && request.resource.data.role in ['student_individual', 'student_collaborative']
        && !('password' in request.resource.data);

      // Only the platform administrator can change user profiles or roles.
      // A user cannot grant themselves privileges by editing their own role.
      allow update, delete: if isPlatformAdmin();
    }

    match /groups/{groupId} {
      allow read: if isStaffReader() || isTeamMember(groupId);
      allow create, update, delete: if isPlatformAdmin();
    }

    match /units/{unitId} {
      allow read: if signedIn();
      allow create, update, delete: if canEditAcademicContent();
    }

    match /projects/{projectId} {
      allow read: if signedIn();
      allow create, update, delete: if canEditAcademicContent();
    }

    match /submissions/{submissionId} {
      allow read: if isStaffReader() || (signedIn() && (
        resource.data.studentId == request.auth.uid ||
        (resource.data.teamId is string && isTeamMember(resource.data.teamId))
      ));

      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid;

      // Students may update their own work while drafting/submitting.
      // Staff research/supervisor roles are read-only for submissions;
      // platform_admin retains full control.
      allow update: if isPlatformAdmin() || (signedIn()
        && resource.data.studentId == request.auth.uid
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.status in ['in_progress', 'submitted']);

      allow delete: if isPlatformAdmin();
    }

    match /team_discussions/{messageId} {
      allow read: if isStaffReader()
        || (signedIn() && isTeamMember(resource.data.teamId));

      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && isTeamMember(request.resource.data.teamId);

      allow update, delete: if isPlatformAdmin()
        || (signedIn() && resource.data.senderId == request.auth.uid);
    }

    match /team_tasks/{taskId} {
      allow read: if isStaffReader()
        || (signedIn() && isTeamMember(resource.data.teamId));

      allow create, delete: if isPlatformAdmin();

      allow update: if isPlatformAdmin()
        || (signedIn()
          && isTeamMember(resource.data.teamId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status']));
    }

    match /engagement_logs/{logId} {
      allow read: if isStaffReader()
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isPlatformAdmin()
        || (signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId);

      allow delete: if isPlatformAdmin();
    }

    match /engagement_results/{resultId} {
      // Raw research responses are visible only to the research team and the participant.
      allow read: if isStaffReader()
        || (signedIn() && resource.data.userId == request.auth.uid);

      // Writes are performed only by the authenticated server endpoint using Admin SDK.
      allow create, update, delete: if false;
    }

    // Deny every collection not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
